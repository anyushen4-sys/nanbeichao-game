{
  "name": "nanbeichao-game",
  "version": "1.0.0",
  "description": "南北朝·天下对弈 - 卡牌策略游戏",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "prebuild": "node scripts/generate_card_data_uris.cjs",
    "prebuild:dir": "node scripts/generate_card_data_uris.cjs"
  },
  "author": "安安",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.nanbeichao.game",
    "productName": "南北朝天下对弈",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "南北朝天下对弈"
    }
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  }
}
